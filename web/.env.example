# Site
NEXT_PUBLIC_SITE_URL=https://localhost:3000

# 8453 = Base mainnet, 84532 = Base Sepolia
NEXT_PUBLIC_CHAIN_ID=8453

# After `forge script` deploy
NEXT_PUBLIC_CHECK_IN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Base.dev project
NEXT_PUBLIC_BASE_APP_ID=

# Builder code from Base.dev → Settings → Builder Code (bc_…)
NEXT_PUBLIC_BUILDER_CODE=

# Optional: raw 0x suffix instead of generating from BUILDER_CODE
# NEXT_PUBLIC_BUILDER_CODE_SUFFIX=

# Optional WalletConnect
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
